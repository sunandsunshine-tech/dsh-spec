{
  "name": "dsh-spec",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "package/*"
  ],
  "scripts": {
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "node --test 'tests/**/*.test.ts'",
    "test:watch": "node --test --watch 'tests/**/*.test.ts'",
    "skill:draft": "node skills/dsh-spec-skill-forge/scripts/forge.mjs draft dsh-spec-skill-forge --from skills/dsh-spec-skill-forge",
    "skill:build": "node scripts/build-skills.ts",
    "skill:pair": "node skills/dsh-spec-skill-forge/scripts/forge.mjs pair dsh-spec-skill-forge --companion .zh.md --companion .i18n.yaml",
    "skill:publish": "node skills/dsh-spec-skill-forge/scripts/forge.mjs publish dsh-spec-skill-forge --into skills/dsh-spec-skill-forge --companion .zh.md --companion .i18n.yaml",
    "skill:refresh": "node scripts/refresh-skills.ts"
  }
}
