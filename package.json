{
  "name": "dsh-spec",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "package/*"
  ],
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.11.0",
    "markdown-it": "15.0.3",
    "parse5": "8.1.1",
    "vite-plus": "1.7.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "check:static": "vp check --continue-on-error --deny-warnings",
    "notices:sync": "node scripts/sync-vendored-notices.ts",
    "notices:check": "node scripts/sync-vendored-notices.ts --check",
    "check:corpus": "node scripts/verify-corpus.ts",
    "test": "node --test 'tests/**/*.test.ts'",
    "test:browser-gif": "node --test tests/browser-gif-encoder.media.ts",
    "test:watch": "node --test --watch 'tests/**/*.test.ts'",
    "skill:draft": "node skills/dsh-spec-skill-forge/scripts/forge.mjs draft dsh-spec-skill-forge --from skills/dsh-spec-skill-forge",
    "skill:build": "node scripts/build-skills.ts",
    "skill:publish-bundles": "node scripts/build-skills.ts --publish",
    "skill:verify-bundles": "node scripts/check-bundles.ts",
    "skill:pair": "node skills/dsh-spec-skill-forge/scripts/forge.mjs pair dsh-spec-skill-forge --companion .zh.md --companion .i18n.yaml",
    "skill:publish": "node skills/dsh-spec-skill-forge/scripts/forge.mjs publish dsh-spec-skill-forge --into skills/dsh-spec-skill-forge --companion .zh.md --companion .i18n.yaml",
    "skill:refresh": "node scripts/refresh-skills.ts"
  }
}
