@@ -7,5 +7,37 @@ import { now, useFakeTimers, useRealTimers } from '../support/clock.mjs'
-const original = {
-  featurePresent: Object.hasOwn(process.env, 'FEATURE_FLAG'),
-  feature: process.env.FEATURE_FLAG,
-  cwd: cwd(),
-  clock: now(),
+const FEATURE_FLAG = 'FEATURE_FLAG'
+
+function captureGlobals() {
+  return {
+    feature: {
+      present: Object.hasOwn(process.env, FEATURE_FLAG),
+      value: process.env[FEATURE_FLAG],
+    },
+    cwd: cwd(),
+    clock: now(),
+  }
+}
+
+function restoreGlobals(original) {
+  if (original.feature.present) {
+    process.env[FEATURE_FLAG] = original.feature.value
+  } else {
+    delete process.env[FEATURE_FLAG]
+  }
+
+  chdir(original.cwd)
+
+  if (original.clock === 'real') {
+    useRealTimers()
+  } else {
+    useFakeTimers(original.clock)
+  }
+}
+
+function assertGlobals(expected) {
+  assert.equal(
+    Object.hasOwn(process.env, FEATURE_FLAG),
+    expected.feature.present,
+  )
+  assert.equal(process.env[FEATURE_FLAG], expected.feature.value)
+  assert.equal(cwd(), expected.cwd)
+  assert.equal(now(), expected.clock)
