+
+function restoreGlobals(snapshot) {
+  try {
+    if (snapshot.feature.present) {
+      process.env.FEATURE_FLAG = snapshot.feature.value
+    } else {
+      delete process.env.FEATURE_FLAG
+    }
+  } finally {
+    try {
+      chdir(snapshot.cwd)
+    } finally {
+      if (snapshot.clock === 'real') {
+        useRealTimers()
+      } else {
+        useFakeTimers(snapshot.clock)
+      }
+    }
+  }
 }
 
