--- /dev/null
+++ b/evals/files/slow-suite/tests/report.integration.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { setTimeout as delay } from 'node:timers/promises'
+
+import { expectedReportRows } from './report-contract.mjs'
+
+const representativeScenarioTimeoutMs = 5_000
+let fixtureBuilds = 0
+
+async function expensiveFixture() {
+  fixtureBuilds += 1
+  await delay(80)
+  return { rows: [1, 2, 3] }
+}
+
+test(
+  'representative report passes the shared row contract',
+  { timeout: representativeScenarioTimeoutMs },
+  async () => {
+    const fixture = await expensiveFixture()
+
+    assert.deepEqual(fixture.rows, expectedReportRows)
+    assert.equal(fixtureBuilds, 1)
+  },
+)
