{
  "name": "schedule_release",
  "description": "Schedules one release and returns its identifier.",
  "parameters": {
    "type": "object",
    "properties": {
      "environment": {
        "type": "string",
        "enum": [
          "staging",
          "production"
        ],
        "description": "Target environment."
      },
      "replicas": {
        "type": "integer",
        "description": "Number of replicas.",
        "default": 2,
        "minimum": 1,
        "maximum": 10
      },
      "start_at": {
        "type": "string",
        "format": "date-time",
        "description": "Release start instant."
      },
      "timezone": {
        "type": "string",
        "description": "IANA timezone for the release start instant."
      },
      "rollout_strategy": {
        "type": "string",
        "enum": [
          "all-at-once",
          "canary"
        ],
        "description": "How traffic moves to the new release.",
        "default": "all-at-once"
      },
      "canary_percentage": {
        "type": "integer",
        "description": "Traffic percentage for a canary release.",
        "default": 10,
        "minimum": 1,
        "maximum": 100
      },
      "approval_ticket": {
        "type": "string",
        "description": "Approval ticket identifier."
      }
    },
    "required": [
      "environment"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "start_at"
          ]
        },
        "then": {
          "required": [
            "timezone"
          ]
        }
      },
      {
        "if": {
          "required": [
            "timezone"
          ]
        },
        "then": {
          "required": [
            "start_at"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "rollout_strategy": {
              "const": "canary"
            }
          },
          "required": [
            "rollout_strategy"
          ]
        },
        "then": {
          "required": [
            "canary_percentage"
          ]
        },
        "else": {
          "not": {
            "required": [
              "canary_percentage"
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "environment": {
              "const": "production"
            }
          },
          "required": [
            "environment"
          ]
        },
        "then": {
          "required": [
            "approval_ticket"
          ]
        }
      }
    ]
  }
}
